{
  "name": "@wbx-sandbox/mastra",
  "version": "0.1.1",
  "description": "WBX Sandbox provider for Mastra workspaces – isolated Firecracker microVMs in Europe for your agents",
  "license": "MIT",
  "author": "WBX Sandbox",
  "homepage": "https://sandbox.wbx.cz/docs/integrations/mastra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WBX-Sandbox/mastra.git"
  },
  "bugs": "https://github.com/WBX-Sandbox/mastra/issues",
  "keywords": [
    "mastra",
    "sandbox",
    "workspace",
    "agent",
    "microvm",
    "firecracker",
    "code-execution",
    "wbx"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:live": "npm run build && node --test --test-concurrency=1 test/live.test.mjs test/agent.live.test.mjs test/examples.live.test.mjs"
  },
  "dependencies": {
    "wbxsandbox": "^0.2.2"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.80.0-0 <2.0.0-0"
  },
  "devDependencies": {
    "@mastra/core": "1.85.0",
    "@types/node": "^22.20.5",
    "ai": "^6.0.336",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
